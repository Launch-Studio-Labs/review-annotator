{
  "manifest_version": 3,
  "name": "Review Annotator",
  "short_name": "Annotator",
  "version": "0.1.0",
  "description": "Draw and leave notes on any page during site reviews. Annotations stay pinned to the page as you scroll.",
  "homepage_url": "https://github.com/Launch-Studio-Labs/review-annotator",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Review Annotator (Alt+Shift+A)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-annotator": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Turn the annotator on or off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
